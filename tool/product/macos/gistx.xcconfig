// Copied to macos/Runner/Configs/AppInfo.xcconfig by tool/build.dart
// before every macOS build (see _applyProductConfigs). Do not hand-edit
// AppInfo.xcconfig directly -- edit this template instead.
//
// AppInfo.xcconfig's own committed content is always this file's content,
// so a fresh checkout or a crashed build leaves the tree buildable without
// running the tool first. Info.plist already indirects CFBundleName and
// CFBundleIdentifier through these variables, so no .xcodeproj surgery is
// needed -- see CLAUDE.md's "two axes" section.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = gistx

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.gistx.gistx

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2025 com.gistx. All rights reserved.
